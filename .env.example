KAIST_DATA_DIR=.data
KAIST_TIMEZONE=Asia/Seoul
KAIST_SYNC_INTERVAL_MINUTES=60
KAIST_MAX_CONCURRENCY=2
KAIST_MAX_DOWNLOAD_BYTES=52428800
KAIST_HTTP_HOST=127.0.0.1
KAIST_HTTP_PORT=8765
# HTTP mode is deliberately off unless an authenticated deployment is prepared.
KAIST_ENABLE_HTTP=false
# Browser profile is dedicated to this app; never point this at a normal browser profile.
KAIST_BROWSER_PROFILE=.browser-profile
# Personal academic access is limited to verified grades, lectures and graduation.
# Leave these unset until exact read-only screen URLs have been validated.
KAIST_VERIFIED_GRADES_URL=
KAIST_VERIFIED_LECTURES_URL=
KAIST_VERIFIED_GRADUATION_URL=
KAIST_ALLOWED_DOWNLOAD_HOSTS=klms.kaist.ac.kr,portal.kaist.ac.kr,mail.kaist.ac.kr,kaist.gov-dooray.com

